# Copy to .env next to docker-compose.yml (it stays out of git) and fill in.
# The tunnel's id, from `cloudflared tunnel list` (the tunnel named poke).
TUNNEL_ID=
# The tunnel's credentials file, written by `cloudflared tunnel create poke`.
TUNNEL_CREDENTIALS=/Users/arnoudwarschauer/emerald3ds-cloudflared/.cloudflared/REPLACE-WITH-TUNNEL_ID.json
# The data folder: sprites.db (back it up) and sprites.json.
DATA_DIR=/Users/arnoudwarschauer/emerald3ds-sprite-server
# The host port, on 127.0.0.1 only (8787 is taken on the Mac mini). The tunnel does not use it.
PORT=8788
